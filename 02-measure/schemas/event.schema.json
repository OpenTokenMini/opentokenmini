{
  "$id": "event.schema.json",
  "title": "One normalized event (v=1): events/otel.jsonl, events/transcript.jsonl",
  "type": "object", "additionalProperties": false,
  "required": ["v", "kind", "ts", "harness", "source", "session_id", "request_id", "parent_session_id",
               "subagent", "user", "project", "repo", "model", "provider", "tokens", "cost", "cost_basis",
               "duration_ms", "error", "retries", "tools", "tool", "decision", "decision_source"],
  "properties": {
    "v": {"const": 1},
    "kind": {"enum": ["api_call", "user_prompt", "tool_decision"]},
    "ts": {"$ref": "common.schema.json#/$defs/ts"},
    "harness": {"$ref": "common.schema.json#/$defs/harness"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "session_id": {"type": "string", "minLength": 1},
    "request_id": {"type": ["string", "null"]},
    "parent_session_id": {"type": ["string", "null"]},
    "subagent": {"type": "boolean"},
    "user": {"$ref": "common.schema.json#/$defs/hash12"},
    "project": {"type": "string"},
    "repo": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "tokens": {"$ref": "common.schema.json#/$defs/tokens"},
    "cost": {"$ref": "common.schema.json#/$defs/cost"},
    "cost_basis": {"$ref": "common.schema.json#/$defs/basis"},
    "query_source": {"type": ["string", "null"], "description": "N-claude-agent: optional; Claude Code OTel query_source (repl_main_thread, agent:builtin:<type>, compact, generate_session_title)"},
    "agent_name": {"type": ["string", "null"], "description": "N-claude-agent: optional; Claude Code OTel agent.name"},
    "agent_type": {"type": "string", "description": "R-claude-agent-type: optional; subagent type from the transcript's agent-<id>.meta.json (agentType)"},
    "cache_split": {"enum": ["unknown"], "description": "N-claude-ttl: optional; present when cache_write has no 5m/1h split (cost is an upper bound)"},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "error": {"type": ["string", "null"]},
    "retries": {"$ref": "common.schema.json#/$defs/count"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "tool": {"type": ["string", "null"]},
    "decision": {"enum": ["accept", "reject", null]},
    "decision_source": {"type": ["string", "null"]}
  }
}
