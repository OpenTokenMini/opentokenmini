{
  "$id": "impact_summary.schema.json",
  "title": "Impact summary (v=1): impact_summary.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "generated", "repos_scanned", "sessions_total", "sessions_linked", "by_repo", "by_harness", "unlinked_cost"],
  "properties": {
    "v": {"const": 1},
    "generated": {"$ref": "common.schema.json#/$defs/ts"},
    "repos_scanned": {"$ref": "common.schema.json#/$defs/count"},
    "sessions_total": {"$ref": "common.schema.json#/$defs/count"},
    "sessions_linked": {"$ref": "common.schema.json#/$defs/count"},
    "by_repo": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/row"}, {"required": ["repo_label"]}]}},
    "by_harness": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/row"}, {"required": ["harness"]}]}},
    "unlinked_cost": {"$ref": "common.schema.json#/$defs/usd"}
  },
  "$defs": {
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["cost", "sessions", "commits_kept", "commits_reverted", "lines_added", "cost_per_kept_commit", "cost_per_100_lines", "revert_rate"],
      "properties": {
        "repo_label": {"type": "string"},
        "harness": {"$ref": "common.schema.json#/$defs/harness"},
        "cost": {"$ref": "common.schema.json#/$defs/usd"},
        "sessions": {"$ref": "common.schema.json#/$defs/count"},
        "commits_kept": {"$ref": "common.schema.json#/$defs/count"},
        "commits_reverted": {"$ref": "common.schema.json#/$defs/count"},
        "lines_added": {"$ref": "common.schema.json#/$defs/count"},
        "cost_per_kept_commit": {"type": ["number", "null"], "minimum": 0},
        "cost_per_100_lines": {"type": ["number", "null"], "minimum": 0},
        "revert_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
